# bartenderFriend Environment Variables
# Copy this file to .env.local and fill in values as needed.
# All variables are OPTIONAL for Phase 1 — the app works without them.

# Neon Postgres connection string (Phase 2 — not needed for local dev)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local user ID override (optional, defaults to "local-user-1")
# LOCAL_USER_ID=local-user-1
